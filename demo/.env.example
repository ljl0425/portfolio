# 演示模式：1 = 所有外部接口短路，用内置假数据
DEMO_MODE=1

# 服务端口
PORT=15001

# 登录口令（演示版随便填，仅用于页面会话）
OPERATOR_PASSWORD=1

# 以下全部是真实环境才需要的密钥，演示模式不用填。
# 保留这些变量名是为了说明生产版是怎么接外部系统的。
FAB_API_HOST=fab-api.invalid
FAB_API_PORT=3000
FAB_API_KEY=
HOLD_API_KEY=
DBQUERY_API_KEY=
POSTING_API_KEY=
POSTING_API_URL=http://fab-api.invalid:3000/api/v2/chat/completions
EVENT_USER=DEMO-USER
